{
  "name": "adconversion-brain",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "env:check": "bash scripts/doctor.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:licenses",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:audit": "pnpm audit --prod --audit-level high",
    "stack:init": "bash scripts/stack-init.sh",
    "stack:up": "docker compose -f deploy/local/docker-compose.yml --env-file deploy/local/.env up -d --wait",
    "stack:down": "docker compose -f deploy/local/docker-compose.yml --env-file deploy/local/.env down",
    "stack:reset": "docker compose -f deploy/local/docker-compose.yml --env-file deploy/local/.env down -v",
    "stack:logs": "docker compose -f deploy/local/docker-compose.yml --env-file deploy/local/.env logs",
    "check:knowledge": "vitest run packages/knowledge",
    "stack:seed": "node tools/stack/src/seed.ts",
    "test:stack": "BRAIN_STACK=1 vitest run tools/stack --testTimeout=60000 --no-file-parallelism",
    "gateway": "node --disable-warning=ExperimentalWarning --env-file-if-exists=deploy/local/.env --env-file-if-exists=deploy/local/gateway.env apps/gateway/src/main.ts",
    "brain": "node --disable-warning=ExperimentalWarning --env-file-if-exists=deploy/local/.env --env-file-if-exists=deploy/local/gateway.env apps/gateway/src/cli.ts",
    "skills": "node tools/skills-sync/src/cli.ts",
    "ingest": "node --disable-warning=ExperimentalWarning apps/ingest/src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^22.20.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
